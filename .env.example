# Local Postgres (used by docker-compose.yml)
POSTGRES_DB=alltix_oms
POSTGRES_USER=alltix_admin
POSTGRES_PASSWORD=change_me_admin

# Migration role: owns the schema, must NOT be used by application code
# (Postgres does not apply RLS policies to table owners/superusers).
DATABASE_URL=postgres://alltix_admin:change_me_admin@localhost:5432/alltix_oms

# Least-privilege role every service connects as. RLS policies are enforced
# for this role. Created by packages/db/migrations/0001_extensions_and_roles.sql.
APP_USER_PASSWORD=change_me_app
APP_DATABASE_URL=postgres://app_user:change_me_app@localhost:5432/alltix_oms

# packages/web -- Clerk auth (get real values from the Clerk dashboard). The
# publishable key below is a structurally-valid but fake placeholder (Clerk
# validates key *format* on every request, before it even checks whether a
# route is public), so leaving it as an arbitrary string like
# "pk_test_replace_me" 500s every request including the e2e test's.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZmFrZS10ZXN0LWFwcC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_replace_me
# Signing secret for the /api/webhooks/clerk endpoint (Clerk dashboard ->
# Webhooks -> your endpoint -> Signing Secret). Required so the webhook route
# can verify inbound payloads are actually from Clerk before provisioning a
# tenant (CLAUDE.md §6: never trust an unsigned webhook payload).
CLERK_WEBHOOK_SECRET=whsec_replace_me

# packages/web -- test-only bypass of Clerk auth, used exclusively by
# test/tenant-isolation.e2e.test.ts to simulate two different signed-in users
# via the x-test-clerk-user-id header instead of real Clerk sessions. Only
# honored when NODE_ENV !== "production" (see src/lib/auth-context.ts) --
# `next build`/`next start` force NODE_ENV to "production" regardless of this
# file, so leave this unset/false everywhere except the e2e test's own
# environment, and never set it in a deployed environment's config.
ALLTIX_TEST_AUTH_BYPASS=false

AMAZON_SANDBOX_CLIENT_ID=
AMAZON_SANDBOX_CLIENT_SECRET=
AMAZON_SANDBOX_REFRESH_TOKEN=
# Seller/Merchant ID -- required as a path segment by the Listings Items API
# (AmazonConnector.pushInventory). The SP-API sandbox doesn't validate this
# value against anything real, so any non-empty string works there; a real
# tenant's actual value is captured during OAuth onboarding and belongs in
# channel_connections.external_account_id, not this env var.
AMAZON_SANDBOX_SELLER_ID=

# Arif's own real Seller Central app credentials -- completely separate
# from AMAZON_SANDBOX_* above, never mix them. Used only by
# scripts/amazon-production-smoke-test.ts (loadAmazonProductionCredentialsFromEnv())
# and, deliberately, nowhere else yet: pushInventory/confirmShipment against
# production aren't built until Arif has picked a safe test SKU and placed
# a self-test order. Leave these unset until that walkthrough happens.
AMAZON_PRODUCTION_CLIENT_ID=
AMAZON_PRODUCTION_CLIENT_SECRET=
AMAZON_PRODUCTION_REFRESH_TOKEN=
AMAZON_PRODUCTION_SELLER_ID=
# Real marketplace id for Arif's account (e.g. the UK marketplace, if his
# seller account matches this repo's existing UK/EU sandbox assumption) --
# deliberately not defaulted the way the sandbox connector defaults to the
# US marketplace id; the production smoke test's own
# getMarketplaceParticipations() call is the way to find the real value if
# it isn't already known, not a guess baked in here.
AMAZON_PRODUCTION_MARKETPLACE_ID=
# Optional -- override only if Arif's account isn't EU (see
# SP_API_NA_PRODUCTION_BASE_URL / SP_API_FE_PRODUCTION_BASE_URL in
# amazon-connector.ts). Unset defaults to the EU production host.
AMAZON_PRODUCTION_BASE_URL=

# "Connect Amazon" OAuth flow (packages/web/src/app/api/channels/amazon/{connect,callback},
# packages/channel-connectors/src/amazon-oauth.ts) -- the redirect-based
# Website Authorization Workflow, distinct from the AMAZON_SANDBOX_* self-
# authorization credentials above. Left blank: there is no Public SP-API
# application registered for this repo yet (only the Private app the
# AMAZON_SANDBOX_* values above belong to), and per Amazon's docs a Private
# application cannot use this flow at all -- see the header comment in
# amazon-oauth.ts. Leaving these unset makes /api/channels/amazon/connect
# fail loudly with a clear "missing env var" error rather than redirecting
# somewhere broken. Fill in once/if this app is published as Public:
AMAZON_APP_ID=
AMAZON_OAUTH_CLIENT_ID=
AMAZON_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered for AMAZON_APP_ID in Seller
# Central's Developer Console -- e.g. https://<your-domain>/api/channels/amazon/callback
AMAZON_OAUTH_REDIRECT_URI=
# "false" once AMAZON_APP_ID is a Published (not Draft) application -- see
# amazon-oauth.ts's buildAmazonAuthorizeUrl. Defaults to true (Draft) when unset.
AMAZON_APP_DRAFT=true
# No marketplace comes back on the OAuth callback itself (only
# selling_partner_id does) -- see the callback route's comment. Defaults to
# "US" when unset.
AMAZON_OAUTH_DEFAULT_MARKETPLACE=US
# HMAC key signing the callback's CSRF `state` param
# (packages/web/src/lib/amazon-oauth-state.ts). Generate with e.g.
# `openssl rand -base64 32`. Distinct from CHANNEL_CREDENTIALS_ENCRYPTION_KEY
# below on purpose -- see that file's header comment.
AMAZON_OAUTH_STATE_SECRET=

# packages/channel-connectors/src/shopify-connector.ts -- channel #3
# (CLAUDE.md §8 Phase 3). A Shopify development store's custom-app Admin API
# access token -- structurally simpler than the Amazon/Walmart credentials
# above: no client secret, no refresh token, a single non-expiring shpat_...
# token. Get these from a free Shopify Partner account: create a development
# store, then in that store's admin go to Settings -> Apps and sales
# channels -> Develop apps -> Create an app, configure the Admin API scopes
# this connector needs (read_orders, write_inventory, and one of
# write_assigned_fulfillment_orders/write_merchant_managed_fulfillment_orders/
# write_third_party_fulfillment_orders -- see confirmShipment's doc comment
# for why not write_fulfillments), install the app, and copy the Admin API
# access token shown once at install time. This connector is
# connector-class-only for now (no DB migration, no scheduler wiring, no
# Settings UI, no webhook route) -- see shopify-connector.ts's header
# comment -- so these vars are only consumed directly by
# loadShopifyCredentialsFromEnv() and scripts/shopify-sandbox-smoke-test.ts,
# the same "prove it works before wiring per-tenant storage" order Amazon's
# own AMAZON_SANDBOX_* credentials were built and verified in.
SHOPIFY_SANDBOX_SHOP_DOMAIN=
SHOPIFY_SANDBOX_ACCESS_TOKEN=

# Symmetric key pgcrypto uses to encrypt/decrypt
# channel_connections.encrypted_client_secret / encrypted_refresh_token (see
# packages/db/migrations/0012_channel_connections.sql and
# packages/db/src/encryption.ts). Interim stand-in for the KMS-backed
# encryption CLAUDE.md §6 calls for -- no KMS integration exists yet.
# Rotating this value requires re-encrypting existing rows with the new key.
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# Billing/Subscription (CLAUDE.md §1, §5 Stripe Billing) -- @alltix/billing-service.
# TEST-MODE KEYS ONLY (sk_test_.../whsec_.../price_... created in test mode).
# There is exactly one tenant self-testing this right now, not a paying
# customer -- no reason to ever put a live-mode key here.
STRIPE_SECRET_KEY=
# From the Stripe Dashboard's webhook endpoint config, or printed by
# `stripe listen --forward-to <url>/api/webhooks/stripe` for local testing
# (that command prints its own whsec_... to use while it's running).
STRIPE_WEBHOOK_SECRET=
# One flat MVP-plan Price id (CLAUDE.md §8 Phase 2: one tier, not a matrix
# yet) -- create it with `npm run stripe:setup-mvp-plan`, which is
# idempotent and prints the id to save here.
STRIPE_MVP_PRICE_ID=

# Vercel Cron Jobs (vercel.json's `crons` entry) -- secures
# GET /api/cron/amazon-order-sync so only Vercel's own scheduled invocation
# can trigger a sync pass, per Vercel's documented pattern
# (https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs):
# set this in the Vercel project's env vars (a random 16+ char string --
# a password generator works fine) and Vercel automatically sends it back as
# `Authorization: Bearer <value>` on every cron invocation. Unset locally is
# fine -- the route 401s with no secret configured rather than accepting
# unauthenticated requests, and local runs go through
# `npm run amazon:order-sync-job` instead, same as before this existed.
CRON_SECRET=

# Marketing site "Book a Demo" lead capture
# (src/app/(marketing)/book-a-demo, src/app/api/leads/demo-request). Every
# submission is always saved to the demo_requests table regardless of these
# -- they only control the *optional* best-effort email notification via
# Resend's HTTP API (https://resend.com). Leave both unset to skip email
# entirely and rely on querying demo_requests directly.
RESEND_API_KEY=
# Where new demo-request notifications get sent.
DEMO_REQUEST_NOTIFY_EMAIL=
# Optional -- must be a domain verified in Resend to actually deliver;
# defaults to Resend's own sandbox sender otherwise.
DEMO_REQUEST_FROM_EMAIL=