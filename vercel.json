{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build && npm run build:web",
  "outputDirectory": "packages/web/.next",
  "crons": [
    {
      "path": "/api/cron/amazon-order-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/shopify-catalog-sync",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/shopify-order-sync",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/walmart-order-sync",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/ebay-order-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/temu-order-sync",
      "schedule": "30 6 * * *"
    },
        {
      "path": "/api/cron/tiktok-order-sync",
      "schedule": "0 7 * * *"
    }

  ]
}
