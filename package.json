{
  "name": "alltix-oms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:web": "npm run build --workspace=@alltix/web",
    "clean": "tsc -b --clean",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "test": "bash scripts/run-tests.sh",
    "test:amazon-sandbox": "bash scripts/run-tests.sh --amazon-sandbox",
    "amazon:sandbox-smoke-test": "tsx scripts/amazon-sandbox-smoke-test.ts",
    "amazon:production-smoke-test": "tsx scripts/amazon-production-smoke-test.ts",
    "amazon:seed-test-channel-connection": "tsx scripts/seed-test-channel-connection.ts",
    "amazon:seed-test-product-catalog": "tsx scripts/seed-test-product-catalog.ts",
    "amazon:pull-orders-smoke-test": "tsx scripts/amazon-pull-orders-smoke-test.ts",
    "amazon:push-inventory-smoke-test": "tsx scripts/amazon-push-inventory-smoke-test.ts",
    "amazon:oauth-token-exchange-isolation-test": "tsx scripts/amazon-oauth-token-exchange-isolation-test.ts",
    "amazon:order-sync-job": "tsx scripts/amazon-order-sync-job.ts",
    "amazon:order-sync-scheduler": "tsx scripts/amazon-order-sync-scheduler.ts",
    "stripe:setup-mvp-plan": "tsx scripts/stripe-setup-mvp-plan.ts",
    "shopify:sandbox-smoke-test": "tsx scripts/shopify-sandbox-smoke-test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
